[
  {
    "id": "image-to-image",
    "label": "Image",
    "kind": "conversion",
    "from": {
      "kind": "image",
      "not": {
        "format": "svg"
      }
    },
    "to": "@writable:image",
    "engines": [
      "vips",
      "magick",
      "orbit-native"
    ],
    "requires": [],
    "defaults": {
      "quality": 82
    },
    "options": [
      "quality",
      "resize_mode",
      "percent",
      "max_dim",
      "resize_preset",
      "strip_metadata",
      "background"
    ],
    "rank": 60
  },
  {
    "id": "vector-to-image",
    "label": "Vector to bitmap",
    "kind": "conversion",
    "from": {
      "format": "svg"
    },
    "to": "@writable:image",
    "engines": [
      "vips",
      "magick"
    ],
    "requires": [
      "op:raster"
    ],
    "defaults": {
      "scale": 1,
      "background": "#ffffff",
      "quality": 90
    },
    "options": [
      "scale",
      "background",
      "quality"
    ],
    "rank": 40,
    "note": "Rendered at scale 1 by default; use scale 2 for retina screens."
  },
  {
    "id": "heic-to-image",
    "label": "iPhone photo",
    "kind": "conversion",
    "from": {
      "format": "heic"
    },
    "to": "@writable:image",
    "engines": [
      "libheif",
      "vips",
      "magick"
    ],
    "requires": [
      "op:raster"
    ],
    "defaults": {
      "quality": 90,
      "strip_metadata": false
    },
    "options": [
      "quality",
      "resize_mode",
      "max_dim"
    ],
    "rank": 70,
    "note": "heif-convert writes only PNG and JPEG, so it is used for those two targets and libvips for the rest."
  },
  {
    "id": "image-to-pdf",
    "label": "Image to PDF",
    "kind": "conversion",
    "from": {
      "kind": "image"
    },
    "to": "pdf",
    "engines": [
      "magick",
      "orbit-native",
      "libreoffice"
    ],
    "requires": [
      "op:image_layout"
    ],
    "defaults": {
      "page": "a4",
      "margin": "0cm",
      "orientation": "auto",
      "quality": 85
    },
    "options": [
      "page",
      "margin",
      "orientation",
      "quality"
    ],
    "rank": 45,
    "note": "One image on one page, at the page size and margin chosen. Several images dragged together become one multi-page PDF instead, through Merge."
  },
  {
    "id": "pdf-to-image",
    "label": "PDF to image",
    "kind": "conversion",
    "from": {
      "format": "pdf"
    },
    "to": "@writable:image",
    "only": [
      "png",
      "jpg",
      "webp",
      "tiff",
      "avif"
    ],
    "engines": [
      "poppler",
      "magick",
      "ghostscript"
    ],
    "requires": [
      "op:pdf_render"
    ],
    "defaults": {
      "dpi": "150",
      "pages": "1-",
      "quality": 85
    },
    "options": [
      "dpi",
      "pages",
      "quality"
    ],
    "rank": 50,
    "note": "Renders the chosen pages as a numbered series. A single page keeps the plain name; a range becomes scan (converted 001).png, 002, …"
  },
  {
    "id": "pdf-to-text",
    "label": "PDF to text",
    "kind": "conversion",
    "from": {
      "format": "pdf"
    },
    "to": "txt",
    "engines": [
      "poppler"
    ],
    "requires": [
      "op:pdf_text"
    ],
    "defaults": {
      "layout": true,
      "pages": "1-"
    },
    "options": [
      "pages",
      "layout"
    ],
    "rank": 40
  },
  {
    "id": "pdf-to-docx",
    "label": "PDF to Word",
    "kind": "conversion",
    "from": {
      "format": "pdf"
    },
    "to": "docx",
