      "libreoffice"
    ],
    "requires": [
      "op:doc_convert"
    ],
    "defaults": {},
    "options": [],
    "rank": 12,
    "note": "LibreOffice imports PDF geometry, so complex layouts come out as positioned boxes."
  },
