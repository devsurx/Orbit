{
  "to": {
    "key": "to",
    "label": "Convert to",
    "type": "format",
    "default": null,
    "help": "Every writable format that fits the dragged file. Resolved at run time against conversions.json."
  },
  "quality": {
    "key": "quality",
    "label": "Quality",
    "type": "range",
    "min": 1,
    "max": 100,
    "default": 82,
    "help": "Lower means smaller files."
  },
  "compress_mode": {
    "key": "compress_mode",
    "label": "How to compress",
    "type": "enum",
    "values": [
      "quality",
      "target_size"
    ],
    "default": "quality",
    "labels": {
      "quality": "Pick a quality",
      "target_size": "Hit a file size"
    }
  },
  "target_size": {
    "key": "target_size",
    "label": "Target size",
    "type": "bytes",
    "default": 10485760,
    "show_if": {
      "compress_mode": "target_size"
    },
    "search": {
      "params": [
        "quality",
        "scale"
      ],
      "max_attempts": 6
    },
    "help": "Orbit re-encodes a few times to land under this size."
  },
  "resize_mode": {
    "key": "resize_mode",
    "label": "Resize",
    "type": "enum",
    "values": [
      "none",
      "percent",
      "max_dim",
      "preset"
    ],
    "default": "none"
  },
  "percent": {
    "key": "percent",
    "label": "Scale",
    "type": "range",
    "min": 1,
    "max": 400,
    "default": 50,
    "unit": "%",
    "show_if": {
      "resize_mode": "percent"
    }
  },
  "max_dim": {
    "key": "max_dim",
    "label": "Longest side",
    "type": "int",
    "min": 16,
    "max": 16384,
    "default": 1920,
    "unit": "px",
    "show_if": {
      "resize_mode": "max_dim"
    }
  },
  "resize_preset": {
    "key": "resize_preset",
    "label": "Preset",
    "type": "enum",
    "values": [
      "4k",
      "1440p",
      "1080p",
      "720p",
      "480p",
      "square_1080",
      "story_1080x1920",
      "thumbnail"
    ],
    "default": "1080p",
    "labels": {
      "4k": "4K (3840x2160)",
      "1440p": "1440p (2560x1440)",
      "1080p": "1080p (1920x1080)",
      "720p": "720p (1280x720)",
      "480p": "480p (854x480)",
      "square_1080": "Square (1080x1080)",
      "story_1080x1920": "Story (1080x1920)",
      "thumbnail": "Thumbnail (256px)"
    },
    "show_if": {
      "resize_mode": "preset"
    }
  },
  "resolution": {
    "key": "resolution",
    "label": "Resolution",
    "type": "enum",
    "values": [
      "source",
      "4k",
      "1440p",
      "1080p",
      "720p",
      "480p",
      "360p"
    ],
    "default": "source"
  },
  "codec": {
    "key": "codec",
    "label": "Codec",
    "type": "enum",
    "values": [
      "h264",
      "h265",
      "vp9",
      "av1",
      "prores",
      "copy"
    ],
    "default": "h264",
    "help": "H.264 plays everywhere; H.265 and AV1 are smaller but slower."
  },
  "crf": {
    "key": "crf",
    "label": "Quality (CRF)",
    "type": "range",
    "min": 0,
    "max": 51,
    "default": 23,
    "help": "Lower is better and bigger. 18 is near-lossless, 28 is small."
  },
  "bitrate": {
    "key": "bitrate",
    "label": "Bitrate",
    "type": "int",
    "min": 16000,
    "max": 100000000,
    "default": 8000000,
    "unit": "bit/s"
  },
  "audio_codec": {
    "key": "audio_codec",
    "label": "Audio codec",
    "type": "enum",
    "values": [
      "aac",
      "mp3",
      "opus",
      "vorbis",
      "flac",
      "pcm",
      "copy"
    ],
    "default": "aac"
  },
  "audio_bitrate": {
    "key": "audio_bitrate",
    "label": "Audio bitrate",
    "type": "enum",
    "values": [
      "96000",
      "128000",
      "160000",
      "192000",
      "256000",
      "320000"
    ],
    "default": "192000",
    "labels": {
      "96000": "96 kbps",
      "128000": "128 kbps",
      "160000": "160 kbps",
      "192000": "192 kbps",
      "256000": "256 kbps",
      "320000": "320 kbps"
    }
  },
  "sample_rate": {
    "key": "sample_rate",
    "label": "Sample rate",
    "type": "enum",
    "values": [
      "source",
      "22050",
      "44100",
      "48000",
      "96000"
    ],
    "default": "source"
  },
  "channels": {
    "key": "channels",
    "label": "Channels",
    "type": "enum",
    "values": [
      "source",
      "mono",
      "stereo"
    ],
    "default": "source"
  },
  "normalize": {
    "key": "normalize",
    "label": "Normalise loudness",
    "type": "bool",
    "default": false
  },
  "fps": {
    "key": "fps",
    "label": "Frame rate",
    "type": "range",
    "min": 1,
    "max": 120,
    "default": 15,
    "unit": "fps"
  },
  "width": {
    "key": "width",
    "label": "Width",
    "type": "int",
    "min": 16,
    "max": 4096,
    "default": 480,
    "unit": "px"
  },
  "loop": {
    "key": "loop",
    "label": "Repeat",
    "type": "enum",
    "values": [
      "forever",
      "once"
    ],
    "default": "forever"
  },
  "start": {
    "key": "start",
    "label": "Start at",
    "type": "time",
    "default": 0
  },
  "end": {
    "key": "end",
    "label": "End at",
    "type": "time",
    "default": null,
    "help": "Leave empty to run to the end."
  },
  "duration": {
    "key": "duration",
    "label": "Length",
    "type": "time",
    "default": 5
  },
  "time": {
    "key": "time",
    "label": "At",
    "type": "time",
    "default": 1
  },
  "count": {
    "key": "count",
    "label": "How many",
    "type": "int",
    "min": 1,
    "max": 200,
    "default": 1
  },
  "scale": {
    "key": "scale",
    "label": "Scale",
    "type": "range",
    "min": 0.1,
    "max": 8,
    "default": 1,
    "help": "Rasterising scale, for example 2 for a retina-sized PNG."
  },
  "dpi": {
    "key": "dpi",
    "label": "Resolution",
    "type": "enum",
    "values": [
      "72",
      "150",
      "300",
      "600"
    ],
    "default": "150",
    "unit": "dpi"
  },
  "pages": {
    "key": "pages",
    "label": "Pages",
    "type": "text",
    "default": "1-",
    "placeholder": "1-3,7",
    "help": "Pages to render. A single page keeps the plain name; a range or 1- produces a numbered series."
  },
  "pdf_page": {
    "key": "pdf_page",
    "label": "Page",
    "type": "int",
    "min": 1,
    "max": 5000,
    "default": 1,
    "help": "Which single page to render. Leave Pages at a range to get one file per page."
  },
  "layout": {
    "key": "layout",
    "label": "Keep layout",
    "type": "bool",
    "default": true
  },
  "page": {
    "key": "page",
    "label": "Paper size",
    "type": "enum",
    "values": [
      "a4",
      "a3",
      "letter",
      "legal",
      "source"
    ],
    "default": "a4"
  },
  "margin": {
    "key": "margin",
    "label": "Margin",
    "type": "text",
    "default": "2cm"
  },
  "orientation": {
    "key": "orientation",
    "label": "Orientation",
    "type": "enum",
    "values": [
      "auto",
      "portrait",
      "landscape"
    ],
    "default": "auto"
  },
  "toc": {
    "key": "toc",
    "label": "Add a table of contents",
    "type": "bool",
    "default": false
  },
  "delimiter": {
    "key": "delimiter",
    "label": "Delimiter",
    "type": "enum",
    "values": [
      ",",
      ";",
      "tab",
      "|"
    ],
    "default": ","
  },
  "header": {
    "key": "header",
    "label": "First row is a header",
    "type": "bool",
    "default": true
  },
  "sheet": {
    "key": "sheet",
    "label": "Sheet",
    "type": "text",
    "default": "1",
    "placeholder": "1 or Sheet1"
  },
  "background": {
    "key": "background",
    "label": "Background",
    "type": "text",
    "default": "#ffffff",
    "help": "Used where the target format has no transparency."
  },
  "size": {
    "key": "size",
    "label": "Canvas",
    "type": "text",
    "default": "1920x1080",
    "placeholder": "1920x1080"
  },
  "visualize_mode": {
    "key": "visualize_mode",
    "label": "Picture",
    "type": "enum",
    "values": [
      "waveform",
      "spectrum",
      "cover"
    ],
    "default": "waveform",
    "labels": {
      "waveform": "Waveform",
      "spectrum": "Spectrum",
      "cover": "Cover art"
    }
  },
  "strip_metadata": {
    "key": "strip_metadata",
    "label": "Remove metadata",
    "type": "bool",
    "default": false,
    "help": "Drops EXIF, GPS, camera and software tags."
  },
  "aspect": {
    "key": "aspect",
    "label": "Aspect ratio",
    "type": "enum",
    "values": [
      "free",
      "1:1",
      "4:3",
      "3:2",
      "16:9",
      "9:16",
      "3:4",
      "2:3"
    ],
    "default": "free"
  },
  "region": {
    "key": "region",
    "label": "Crop",
    "type": "region",
    "default": null,
    "help": "Drag on the preview, or type left,top,width,height."
  },
  "rotate": {
    "key": "rotate",
    "label": "Rotate",
    "type": "enum",
    "values": [
      "90",
      "180",
      "270"
    ],
    "default": "90"
  },
  "flip_axis": {
    "key": "flip_axis",
    "label": "Axis",
    "type": "enum",
    "values": [
      "horizontal",
      "vertical"
    ],
    "default": "horizontal"
  },
  "ocr_lang": {
    "key": "ocr_lang",
    "label": "Language",
    "type": "enum",
    "values": [
      "auto",
      "eng",
      "deu",
      "fra",
      "spa",
      "ita",
      "por",
      "nld",
      "pol",
      "rus",
      "tur",
      "jpn",
      "chi_sim",
      "chi_tra",
      "kor",
      "ara",
      "hin"
    ],
    "default": "auto"
  },
  "ocr_output": {
    "key": "ocr_output",
    "label": "Output",
    "type": "enum",
    "values": [
      "txt",
      "searchable_pdf"
    ],
    "default": "txt",
    "labels": {
      "txt": "Plain text",
      "searchable_pdf": "Searchable PDF"
    }
  },
  "merge_output": {
    "key": "merge_output",
    "label": "Result",
    "type": "enum",
    "values": [
      "pdf",
      "video",
      "audio",
      "gif"
    ],
    "default": "pdf"
  },
  "merge_order": {
    "key": "merge_order",
    "label": "Order",
    "type": "enum",
    "values": [
      "as_dragged",
      "name",
      "date"
    ],
    "default": "as_dragged",
    "labels": {
      "as_dragged": "As dragged",
      "name": "By name",
      "date": "Oldest first"
    }
  },
  "pdf_compress_level": {
    "key": "pdf_compress_level",
    "label": "Effort",
    "type": "enum",
    "values": [
      "lossless",
      "balanced",
      "aggressive"
    ],
    "default": "balanced",
    "help": "Lossless only tidies the PDF structure. Aggressive re-rasterises pages and needs Ghostscript."
  },
  "frame_step": {
    "key": "frame_step",
    "label": "Every",
    "type": "number",
    "min": 0.05,
    "max": 3600,
    "default": 1,
    "unit": "s",
    "help": "Seconds between frames."
  },
  "frame_limit": {
    "key": "frame_limit",
    "label": "At most",
    "type": "int",
    "min": 1,
    "max": 10000,
    "default": 100,
    "unit": "frames",
    "help": "Cap on the number of stills, so a long clip cannot fill the disk."
  }
}
